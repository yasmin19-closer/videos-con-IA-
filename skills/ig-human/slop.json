  "tells": [
    {
      "id": "em-dash",
      "name": "Em dash",
      "pattern": "\\s?—\\s?",
      "flags": "",
      "fix": ", ",
      "min_count": 1,
      "note": "The punctuation models overuse; a comma or a period reads human."
    },
    {
      "id": "en-dash",
      "name": "Spaced en dash",
      "pattern": "\\s–\\s",
      "flags": "",
      "fix": ", ",
      "min_count": 1,
      "note": "Same tic as the em dash, typed differently."
    },
    {
      "id": "not-x-its-y",
      "name": "Not X, it's Y",
      "pattern": "\\b(?:it'?s|this is|that'?s) not (?:just |only |about )?[^,.;\\n]{1,40}[,;] (?:it'?s|but)\\b|\\bno es (?:solo |sólo |solamente )?[^,.;\\n]{1,40}[,;] es\\b",
      "flags": "i",
      "fix": null,
      "min_count": 1,
      "note": "Say Y directly."
    },
    {
      "id": "not-only-but",
      "name": "Not only X but Y",
      "pattern": "\\bnot (?:just|only) [^,.;\\n]{1,40},? but (?:also )?|\\bno (?:solo|sólo|solamente) [^,.;\\n]{1,40},? sino (?:también )?",
      "flags": "i",
      "fix": null,
      "min_count": 1,
      "note": "Pick the stronger half."
    },
    {
      "id": "rule-of-three",
      "name": "Rule of three",
      "pattern": "\\b\\w+, \\w+(?: \\w+)?,? (?:and|y|e) \\w+\\b",
      "flags": "i",
      "fix": null,
      "min_count": 2,
      "note": "One list of three is fine; a habit of them is a tell. Cut to two or one."
    },
    {
      "id": "transition",
      "name": "Stock transition opener",
      "pattern": "(?m)(?:^|(?<=[.!?] ))(?:Moreover|Furthermore|Additionally|In conclusion|In summary|Ultimately|Overall|Notably|Importantly|Además|Asimismo|Por otro lado|En conclusión|En resumen|Por último|Finalmente|En definitiva|De igual manera),\\s*",
      "flags": "",
      "fix": "",
      "min_count": 1,
      "note": "Delete it; the sentence works without it."
    },
    {
      "id": "double-punct",
      "name": "Doubled punctuation",
      "pattern": "([!?])\\1+",
      "flags": "",
      "fix": "\\1",
      "min_count": 1,
      "note": "One mark is enough."
    },
    {
      "id": "ellipsis",
      "name": "Ellipsis habit",
      "pattern": "\\.\\.\\.|…",
      "flags": "",
      "fix": null,
      "min_count": 2,
      "note": "Trailing off on purpose works once."
    },
    {
      "id": "reveal",
      "name": "Rhetorical reveal",
      "pattern": "\\b(?:the|el|la|lo) (?:result|truth|secret|catch|answer|kicker|best part|resultado|verdad|secreto|truco|respuesta|mejor|peor)\\?",
      "flags": "i",
      "fix": null,
      "min_count": 1,
      "note": "\"The result? X.\" Just say X."
    },
    {
      "id": "heres-the-thing",
      "name": "Here's the thing",
      "pattern": "\\bhere'?s the (?:thing|kicker|catch|deal|truth)\\b|\\b(?:y )?aqu[ií] (?:va|est[aá]) (?:la cosa|el truco|lo importante)\\b|\\bte explico:",
      "flags": "i",
      "fix": null,
      "min_count": 1,
      "note": "Throat-clearing before the point."
    },
    {
      "id": "emoji-bullets",
      "name": "Emoji bullets",
      "pattern": "(?m)^\\s*(?:✅|\\U0001F449|\\U0001F680|✨|\\U0001F525|\\U0001F4A1|\\U0001F4CC|⭐|✔️?|➡️?|\\U0001F3AF|\\U0001F4A5)",
      "flags": "",
